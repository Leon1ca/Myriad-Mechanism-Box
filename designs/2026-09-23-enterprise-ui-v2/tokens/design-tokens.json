        "title": "合同协议号",
        "width": 150
      },
      {
        "key": "port",
        "title": "出境关别",
        "width": 110
      },
      {
        "key": "dest",
        "title": "目的国",
        "width": 76
      },
      {
        "key": "amount",
        "title": "关单总货值",
        "width": 160,
