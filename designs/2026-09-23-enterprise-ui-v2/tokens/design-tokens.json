    "width": {
      "compact": {
        "below": 1320,
        "kpiPanelWidth": 420,
        "searchWidth": 340
      },
      "standard": {
        "from": 1320,
        "below": 1680,
        "kpiPanelWidth": 480,
        "searchWidth": 340
      },
      "wide": {
        "from": 1680,
