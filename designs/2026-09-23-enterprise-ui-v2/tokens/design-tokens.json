      "standard": {
        "from": 820,
        "contentPadding": [
          20,
          24
        ],
        "sectionGap": 16,
        "kpiPadding": [
          14,
          18
        ],
        "kpiValuePx": 26,
        "amountHeader": 40,
        "amountColumnHeader": 30,
        "amountRow": 32,
        "toolbar": 56,
        "tableRow": 54
      }
    },
    "tableColumns": {
      "rule": "按收货人列实际宽度判定：< 180 先压缩；仍 < 180 合并“出境关别/目的国”；> 420 时收货人封顶 420，余量均分给合同号、关别、目的国",
      "consigneeMin": 180,
      "consigneeMax": 420,
      "standard": {
        "index": 28,
        "status": 76,
        "number": 200,
        "contract": 150,
        "port": 110,
        "dest": 76,
        "amount": 160,
        "detail": 72,
        "verify": 92
